setopt extendedhistory
setopt sharehistory
setopt histfcntllock
setopt noclobber
setopt clobberempty
setopt nohashcmds
setopt extendedglob
export ZSH="$HOME/.oh-my-zsh"
plugins=(
    zsh-syntax-highlighting
    zsh-completions
    zsh-autosuggestions
    zsh-navigation-tools
    archlinux
    systemd
    zsh-vi-mode
    zoxide
    auto-ls
    fnm
)
# typeset -A ZVMMS
# ZVMMS[i]='%K{#8f8}  INSERT  %k'
# ZVMMS[n]='%K{#f88}  NORMAL  %k'
# ZVMMS[v]='%K{#f88}  VISUAL  %k'
# ZVMMS[vl]='%K{#f88}  V-LINE  %k'
# ZVMMS[r]='%K{#f88}  REPLACE  %k'
export PS1=$'%F{#fff}%K{#411}%~%k %K{#338}%E%f%k\n'
export PS2=
export PS3=
export PS4=
export RPS1=
export HISTFILE="$HOME/.zsh_history"
export HISTSIZE=100000000000
export SAVEHIST=100000000000
export MANPAGER='less -R --use-color -Dd+b -Du+r'
export MANROFFOPT='-P -c -rHY=0 -rIN=4n -rU1'
export ZSH_AUTOSUGGEST_STRATEGY=(history completion)
export ZSH_AUTOSUGGEST_USE_ASYNC=1
HYPHEN_INSENSITIVE="true"
zstyle ':omz:update' mode auto
zstyle ':omz:update' frequency 1
DISABLE_MAGIC_FUNCTIONS="true"
DISABLE_LS_COLORS="true"
export HIST_STAMPS="mm/dd/yyyy"
export HIST_STAMPS='%Y_%m_%d__%H_%M_%S'
_ZO_ECHO=1
KEYTIMEOUT=1
ZVM_SYSTEM_CLIPBOARD_ENABLED=true
ZVM_LAZY_KEYBINDINGS=true
ZVM_KEYTIMEOUT=999
zvm_config() {
    ZVM_NORMAL_MODE_CURSOR=$ZVM_CURSOR_BLOCK
    ZVM_INSERT_MODE_CURSOR=$ZVM_CURSOR_BEAM
    ZVM_OPPEND_MODE_CURSOR=$ZVM_CURSOR_UNDERLINE
    ZVM_READKEY_ENGINE=$ZVM_READKEY_ENGINE_NEX
    ZVM_LINE_INIT_MODE=$ZVM_MODE_LAST
}
zsh-swaymsg-exec() {
    swaymsg exec $BUFFER
}
my_init() {
    zvm_define_widget zsh-swaymsg-exec
    zvm_bindkey viins '^Y' zsh-swaymsg-exec
    zvm_bindkey viins '^R' znt-history-widget
}
zvm_after_init_commands+=(my_init)
ZVM_INIT_MODE=sourcing
ZLS_COLORS=''
auto-ls-handler() {
    lsd -A
}
AUTO_LS_COMMANDS=(handler)
zmodload zsh/complist
source $ZSH/oh-my-zsh.sh
